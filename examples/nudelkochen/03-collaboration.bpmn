<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:message id="Message_1" name="Message" />
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Process_Koch" name="Koch" processRef="Process_Koch" />
    <bpmn:participant id="Participant_Process_Mitbewohner" name="Mitbewohner" processRef="Process_Mitbewohner" />
    <bpmn:messageFlow id="mf_essen_fertig" name="Essen ist fertig" sourceRef="send_fertig" targetRef="catch_essen_fertig" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Koch" isExecutable="false">
    <bpmn:startEvent id="start_koch" name="Kochvorgang gestartet">
      <bpmn:outgoing>flow_start_wasser</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="task_wasser_aufsetzen" name="Wasser aufsetzen">
      <bpmn:incoming>flow_start_wasser</bpmn:incoming>
      <bpmn:outgoing>flow_wasser_hinzufuegen</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_nudeln_hinzufuegen" name="Nudeln hinzufügen">
      <bpmn:incoming>flow_wasser_hinzufuegen</bpmn:incoming>
      <bpmn:outgoing>flow_hinzufuegen_kochen</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_nudeln_kochen" name="Nudeln kochen">
      <bpmn:incoming>flow_hinzufuegen_kochen</bpmn:incoming>
      <bpmn:outgoing>flow_kochen_abgiessen</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_nudeln_abgiessen" name="Nudeln abgießen">
      <bpmn:incoming>flow_kochen_abgiessen</bpmn:incoming>
      <bpmn:outgoing>flow_abgiessen_senden</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="send_fertig" name="Fertigmeldung senden">
      <bpmn:incoming>flow_abgiessen_senden</bpmn:incoming>
      <bpmn:outgoing>flow_senden_ende</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="end_koch" name="Essen serviert">
      <bpmn:incoming>flow_senden_ende</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_start_wasser" sourceRef="start_koch" targetRef="task_wasser_aufsetzen" />
    <bpmn:sequenceFlow id="flow_wasser_hinzufuegen" sourceRef="task_wasser_aufsetzen" targetRef="task_nudeln_hinzufuegen" />
    <bpmn:sequenceFlow id="flow_hinzufuegen_kochen" sourceRef="task_nudeln_hinzufuegen" targetRef="task_nudeln_kochen" />
    <bpmn:sequenceFlow id="flow_kochen_abgiessen" sourceRef="task_nudeln_kochen" targetRef="task_nudeln_abgiessen" />
    <bpmn:sequenceFlow id="flow_abgiessen_senden" sourceRef="task_nudeln_abgiessen" targetRef="send_fertig" />
    <bpmn:sequenceFlow id="flow_senden_ende" sourceRef="send_fertig" targetRef="end_koch" />
  </bpmn:process>
  <bpmn:process id="Process_Mitbewohner" isExecutable="false">
    <bpmn:startEvent id="start_mitbewohner" name="Vorbereitung gestartet">
      <bpmn:outgoing>flow_start_tisch</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="task_tisch_decken" name="Tisch decken">
      <bpmn:incoming>flow_start_tisch</bpmn:incoming>
      <bpmn:outgoing>flow_tisch_catch</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="catch_essen_fertig" name="Essen-fertig-Meldung erhalten">
      <bpmn:incoming>flow_tisch_catch</bpmn:incoming>
      <bpmn:outgoing>flow_catch_servieren</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="task_essen_servieren" name="Nudeln servieren">
      <bpmn:incoming>flow_catch_servieren</bpmn:incoming>
      <bpmn:outgoing>flow_servieren_ende</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end_mitbewohner" name="Tisch fertig gedeckt">
      <bpmn:incoming>flow_servieren_ende</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_start_tisch" sourceRef="start_mitbewohner" targetRef="task_tisch_decken" />
    <bpmn:sequenceFlow id="flow_tisch_catch" sourceRef="task_tisch_decken" targetRef="catch_essen_fertig" />
    <bpmn:sequenceFlow id="flow_catch_servieren" sourceRef="catch_essen_fertig" targetRef="task_essen_servieren" />
    <bpmn:sequenceFlow id="flow_servieren_ende" sourceRef="task_essen_servieren" targetRef="end_mitbewohner" />
  </bpmn:process>
