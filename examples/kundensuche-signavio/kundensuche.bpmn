<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:message id="Message_1" name="Message" />
  <bpmn:error id="Error_2" name="Error" />
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Process" name="Companyname" processRef="Process" />
    <bpmn:participant id="Participant_Pool_Kunde" name="Kunde" />
    <bpmn:messageFlow id="mf_kontaktaufnahme" name="Kontaktaufnahme" sourceRef="Participant_Pool_Kunde" targetRef="start_gp_gesucht" />
  </bpmn:collaboration>
  <bpmn:process id="Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process">
      <bpmn:lane id="lane_service_sales" name="Service &#38; Sales Mitarbeiter">
        <bpmn:flowNodeRef>start_gp_gesucht</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_suchsystem_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_suchsystem_wahl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_suchkriterien_eingeben</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_salesforce_suchen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_ergebnisliste_erstellen_oben</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_ergebnisliste_erstellen_unten</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_merge_suche</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_treffer_vorhanden</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_ergebnisliste_anzeigen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_fehlermeldung_bestaetigen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_ergebnisliste_filtern</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_nochmalige_suche</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_kunde_auswaehlen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_kundenanlage_gewuenscht</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_erfolgreich</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_weiter_kundenanlage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_erfolglos</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_gp_gesucht" name="Es wird ein Geschäftspartner gesucht">
      <bpmn:documentation>Mögliche Kontaktkanäle: Telefon, Brief, Fax, E-Mail, Chat, Visitenkarte etc.</bpmn:documentation>
      <bpmn:outgoing>f_start_gw</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_1" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="gw_suchsystem_merge" name="" gatewayDirection="Converging">
      <bpmn:incoming>f_start_gw</bpmn:incoming>
      <bpmn:incoming>f_nochmal_loop</bpmn:incoming>
      <bpmn:outgoing>f_merge_wahl</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_suchsystem_wahl" name="Welches Suchsystem?" gatewayDirection="Diverging" default="f_gw_salesforce">
      <bpmn:documentation>Auswahl anhand der vorliegenden Kundendaten. Pfad 'Suchkriterien bekannt': mind. eine Information aus Geschäftspartnernummer/Name/Adresse/Telefon/E-Mail ODER Belegnummern (Rechnung/Auftrag/Lieferschein) ODER SAP-ECC-Debitorennummer. Pfad 'Geschäftspartner-/Debitorennummer bekannt': mind. eine Information aus Geschäftspartnernummer/SAP-ECC-Debitorennummer/Name/Adresse/Telefon/E-Mail/Vorgangsnummer.</bpmn:documentation>
      <bpmn:incoming>f_merge_wahl</bpmn:incoming>
      <bpmn:outgoing>f_gw_eingabe</bpmn:outgoing>
      <bpmn:outgoing>f_gw_salesforce</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="task_suchkriterien_eingeben" name="Suchkriterien eingeben">
      <bpmn:incoming>f_gw_eingabe</bpmn:incoming>
      <bpmn:outgoing>f_eingabe_ergoben</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_salesforce_suchen" name="Geschäftspartner in Salesforce suchen">
      <bpmn:incoming>f_gw_salesforce</bpmn:incoming>
      <bpmn:outgoing>f_salesforce_ergunten</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_ergebnisliste_erstellen_oben" name="Ergebnisliste erstellen">
      <bpmn:incoming>f_eingabe_ergoben</bpmn:incoming>
      <bpmn:outgoing>f_ergoben_merge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_ergebnisliste_erstellen_unten" name="Ergebnisliste erstellen">
      <bpmn:incoming>f_salesforce_ergunten</bpmn:incoming>
      <bpmn:outgoing>f_ergunten_merge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_merge_suche" name="" gatewayDirection="Converging">
      <bpmn:incoming>f_ergoben_merge</bpmn:incoming>
      <bpmn:incoming>f_ergunten_merge</bpmn:incoming>
      <bpmn:outgoing>f_merge_treffer</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_treffer_vorhanden" name="Treffer vorhanden?" gatewayDirection="Diverging" default="f_treffer_fehlermeldung">
      <bpmn:incoming>f_merge_treffer</bpmn:incoming>
      <bpmn:outgoing>f_treffer_anzeigen</bpmn:outgoing>
      <bpmn:outgoing>f_treffer_fehlermeldung</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="task_ergebnisliste_anzeigen" name="Ergebnisliste anzeigen">
      <bpmn:incoming>f_treffer_anzeigen</bpmn:incoming>
      <bpmn:outgoing>f_anzeigen_filtern</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_fehlermeldung_bestaetigen" name="Fehlermeldung &#39;keine Kunden gefunden&#39; bestätigen">
      <bpmn:incoming>f_treffer_fehlermeldung</bpmn:incoming>
      <bpmn:outgoing>f_fehlermeldung_nochmal</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_ergebnisliste_filtern" name="Ergebnisliste filtern">
      <bpmn:incoming>f_anzeigen_filtern</bpmn:incoming>
      <bpmn:outgoing>f_filtern_auswaehlen</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_nochmalige_suche" name="Nochmalige Suche gewünscht?" gatewayDirection="Diverging" default="f_nochmal_kundenanlage">
      <bpmn:incoming>f_fehlermeldung_nochmal</bpmn:incoming>
      <bpmn:outgoing>f_nochmal_loop</bpmn:outgoing>
      <bpmn:outgoing>f_nochmal_kundenanlage</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="task_kunde_auswaehlen" name="Kunde aus Ergebnisliste auswählen">
      <bpmn:incoming>f_filtern_auswaehlen</bpmn:incoming>
      <bpmn:outgoing>f_auswaehlen_ende</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_kundenanlage_gewuenscht" name="Kundenanlage gewünscht?" gatewayDirection="Diverging" default="f_kundenanlage_erfolglos">
      <bpmn:incoming>f_nochmal_kundenanlage</bpmn:incoming>
      <bpmn:outgoing>f_kundenanlage_weiter</bpmn:outgoing>
      <bpmn:outgoing>f_kundenanlage_erfolglos</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_erfolgreich" name="Kundensuche/-matching erfolgreich abgeschlossen">
      <bpmn:incoming>f_auswaehlen_ende</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_weiter_kundenanlage" name="Weiter mit Kundenanlage-Prozess">
      <bpmn:documentation>Übergabe an Folgeprozess 'Anlage Kunde durch HG-Unit' (nicht Teil dieses Diagramms).</bpmn:documentation>
      <bpmn:incoming>f_kundenanlage_weiter</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_erfolglos" name="Kundensuche/-matching erfolglos beendet">
      <bpmn:incoming>f_kundenanlage_erfolglos</bpmn:incoming>
      <bpmn:terminateEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_start_gw" sourceRef="start_gp_gesucht" targetRef="gw_suchsystem_merge" />
    <bpmn:sequenceFlow id="f_merge_wahl" sourceRef="gw_suchsystem_merge" targetRef="gw_suchsystem_wahl" />
    <bpmn:sequenceFlow id="f_gw_eingabe" name="Suchkriterien bekannt" sourceRef="gw_suchsystem_wahl" targetRef="task_suchkriterien_eingeben">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Suchkriterien bekannt</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_eingabe_ergoben" sourceRef="task_suchkriterien_eingeben" targetRef="task_ergebnisliste_erstellen_oben" />
    <bpmn:sequenceFlow id="f_ergoben_merge" sourceRef="task_ergebnisliste_erstellen_oben" targetRef="gw_merge_suche" />
    <bpmn:sequenceFlow id="f_gw_salesforce" name="GP-/Debitorennr. bekannt" sourceRef="gw_suchsystem_wahl" targetRef="task_salesforce_suchen" />
    <bpmn:sequenceFlow id="f_salesforce_ergunten" sourceRef="task_salesforce_suchen" targetRef="task_ergebnisliste_erstellen_unten" />
    <bpmn:sequenceFlow id="f_ergunten_merge" sourceRef="task_ergebnisliste_erstellen_unten" targetRef="gw_merge_suche" />
    <bpmn:sequenceFlow id="f_merge_treffer" sourceRef="gw_merge_suche" targetRef="gw_treffer_vorhanden" />
    <bpmn:sequenceFlow id="f_treffer_anzeigen" name="1 - n Treffer" sourceRef="gw_treffer_vorhanden" targetRef="task_ergebnisliste_anzeigen">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">1 - n Treffer</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_anzeigen_filtern" sourceRef="task_ergebnisliste_anzeigen" targetRef="task_ergebnisliste_filtern" />
    <bpmn:sequenceFlow id="f_filtern_auswaehlen" sourceRef="task_ergebnisliste_filtern" targetRef="task_kunde_auswaehlen" />
    <bpmn:sequenceFlow id="f_auswaehlen_ende" sourceRef="task_kunde_auswaehlen" targetRef="end_erfolgreich" />
    <bpmn:sequenceFlow id="f_treffer_fehlermeldung" name="kein Treffer" sourceRef="gw_treffer_vorhanden" targetRef="task_fehlermeldung_bestaetigen" />
    <bpmn:sequenceFlow id="f_fehlermeldung_nochmal" sourceRef="task_fehlermeldung_bestaetigen" targetRef="gw_nochmalige_suche" />
    <bpmn:sequenceFlow id="f_nochmal_loop" name="Ja" sourceRef="gw_nochmalige_suche" targetRef="gw_suchsystem_merge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Ja</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_nochmal_kundenanlage" name="Nein" sourceRef="gw_nochmalige_suche" targetRef="gw_kundenanlage_gewuenscht" />
    <bpmn:sequenceFlow id="f_kundenanlage_weiter" name="Ja" sourceRef="gw_kundenanlage_gewuenscht" targetRef="end_weiter_kundenanlage">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Ja</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_kundenanlage_erfolglos" name="Nein" sourceRef="gw_kundenanlage_gewuenscht" targetRef="end_erfolglos" />
    <bpmn:textAnnotation id="ann_system_tbd_1">
      <bpmn:text>System t.b.d.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="ann_system_tbd_2">
      <bpmn:text>System t.b.d.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="ann_salesforce_1">
