    <bpmn:textAnnotation id="ann_salesforce_2">
      <bpmn:text>Salesforce</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="ann_system_3">
      <bpmn:text>Salesforce, System t.b.d.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="ann_system_4">
      <bpmn:text>Salesforce, System t.b.d.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="ann_system_5">
      <bpmn:text>Salesforce, System t.b.d.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="assoc_4" sourceRef="task_suchkriterien_eingeben" targetRef="ann_system_tbd_1" />
    <bpmn:association id="assoc_5" sourceRef="task_ergebnisliste_erstellen_oben" targetRef="ann_system_tbd_2" />
    <bpmn:association id="assoc_6" sourceRef="task_salesforce_suchen" targetRef="ann_salesforce_1" />
    <bpmn:association id="assoc_7" sourceRef="task_ergebnisliste_erstellen_unten" targetRef="ann_salesforce_2" />
    <bpmn:association id="assoc_8" sourceRef="task_ergebnisliste_anzeigen" targetRef="ann_system_3" />
    <bpmn:association id="assoc_9" sourceRef="task_ergebnisliste_filtern" targetRef="ann_system_4" />
    <bpmn:association id="assoc_10" sourceRef="task_kunde_auswaehlen" targetRef="ann_system_5" />
  </bpmn:process>
